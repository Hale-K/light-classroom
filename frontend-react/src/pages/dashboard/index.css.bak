.wb-page { color: var(--ink); }

.wb-header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  overflow: hidden;
  padding: 16px 20px;
  margin: 0 0 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: linear-gradient(135deg, var(--surface-2) 0%, var(--surface) 100%);
  color: var(--ink);
}
.wb-header::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.12;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: linear-gradient(90deg, black, transparent 70%);
}
.wb-header > div { position: relative; z-index: 1; }
.wb-kicker,
.wb-section-label {
  color: var(--text-3);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
}
.wb-kicker {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--blue-ink);
}
.wb-kicker i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green-ink);
  box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.12);
}
.wb-header h1 {
  margin: 6px 0 4px;
  font-size: 22px;
  line-height: 1.2;
  letter-spacing: -0.04em;
  color: var(--ink);
}
.wb-header p {
  margin: 0;
  color: var(--text-2);
  font-size: 12px;
}
.wb-header-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  color: var(--text-3);
  font-size: 11px;
  white-space: nowrap;
}
.wb-header-meta b {
  color: var(--ink);
  font-size: 12px;
}
.wb-sync {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 3px;
  color: var(--green-ink);
  font-size: 10px;
}
.wb-sync i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green-ink);
}

.wb-flow,
.wb-metrics,
.wb-panel {
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 10px;
}
.wb-flow { padding: 16px 18px; margin-bottom: 12px; }
.wb-flow-heading { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
.wb-flow-heading b { font-size: 14px; }
.wb-flow-heading span { color: var(--text-3); font-size: 12px; }
.wb-flow-track { display: flex; align-items: center; }
.wb-flow-step {
  display: flex;
  align-items: center;
  flex: 1;
  color: var(--text-3);
  font-size: 12px;
  white-space: nowrap;
}
.wb-flow-step i {
  width: 8px;
  height: 8px;
  border: 2px solid var(--border);
  border-radius: 50%;
  background: var(--surface);
  margin-right: 7px;
}
.wb-flow-step.active { color: var(--blue-ink); font-weight: 600; }
.wb-flow-step.active i { border-color: var(--blue-ink); background: var(--blue-ink); }
.wb-flow-step hr { height: 1px; flex: 1; border: 0; background: var(--border); margin: 0 12px; }

.wb-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-bottom: 12px;
  overflow: hidden;
}
.wb-metric { padding: 12px 14px; border-right: 1px solid var(--border); }
.wb-metric:last-child { border-right: 0; }
.wb-metric-label {
  display: flex !important;
  align-items: center;
  gap: 7px;
  color: var(--text-3);
  font-size: 11px;
}
.wb-metric-label i {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border-radius: 6px;
  color: var(--blue-ink);
  background: var(--surface-2);
  font-style: normal;
}
.wb-metric em { display: none; }
.wb-metric strong {
  display: block;
  margin: 6px 0 0;
  color: var(--ink);
  font-size: 22px;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.wb-metric small { font-size: 11px; font-weight: 500; margin-left: 3px; color: var(--text-2); }

.wb-focus-card {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: linear-gradient(135deg, var(--surface-2), var(--surface));
}
.wb-focus-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  color: var(--blue-ink);
  background: var(--pastel-blue);
  flex-shrink: 0;
}
.wb-focus-copy { min-width: 0; flex: 1; }
.wb-focus-copy h2 {
  margin: 4px 0;
  color: var(--ink);
  font-size: 17px;
  letter-spacing: -0.025em;
}
.wb-focus-copy p {
  margin: 0;
  color: var(--text-2);
  font-size: 12px;
  line-height: 1.55;
}
.wb-focus-action {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 36px;
  padding: 0 10px;
  border: 1px solid var(--primary);
  border-radius: 8px;
  color: #fff;
  background: var(--primary);
  font: inherit;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s, border-color 0.15s;
}
.wb-focus-action:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

.wb-schedule-overview {
  margin-bottom: 14px;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
}
.wb-overview-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
.wb-overview-head h2 { margin: 4px 0 0; color: var(--ink); font-size: 16px; }
.wb-overview-head > strong { color: var(--blue-ink); font-size: 24px; line-height: 1; }
.wb-overview-track {
  height: 8px;
  margin: 14px 0 8px;
  border-radius: 99px;
  background: var(--surface-2);
  overflow: hidden;
}
.wb-overview-track i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
  transition: width 0.3s;
}
.wb-overview-meta,
.wb-resource-strip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 20px;
  color: var(--text-3);
  font-size: 11px;
}
.wb-resource-strip {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border-2);
  gap: 10px 22px;
}
.wb-resource-strip span { display: inline-flex; align-items: center; gap: 6px; }
.wb-resource-strip i { width: 7px; height: 7px; border-radius: 50%; background: var(--blue-ink); }
.wb-resource-strip i.violet { background: #7450b5; }
.wb-resource-strip i.green { background: var(--green-ink); }
.wb-resource-strip b { color: var(--ink); font-size: 13px; }

.wb-visual-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 12px; margin-bottom: 14px; }
.wb-visual-panel { padding: 16px 18px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
.wb-live { display: flex; align-items: center; gap: 6px; color: var(--text-3); font-size: 11px; }
.wb-live i { width: 6px; height: 6px; border-radius: 50%; background: var(--green-ink); }
.wb-visual-rows { border-top: 1px solid var(--border-2); }
.wb-visual-row {
  display: grid;
  grid-template-columns: 30px minmax(100px, 1fr) 32px minmax(80px, 0.8fr);
  align-items: center;
  gap: 8px;
  min-height: 50px;
  border-bottom: 1px solid var(--border-2);
}
.wb-visual-row:last-child { border-bottom: 0; }
.wb-visual-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 7px; }
.wb-visual-icon.blue { background: var(--pastel-blue); color: var(--blue-ink); }
.wb-visual-icon.amber { background: var(--pastel-yellow); color: var(--yellow-ink); }
.wb-visual-icon.green { background: var(--pastel-green); color: var(--green-ink); }
.wb-visual-icon.violet { background: #f1ecff; color: #7450b5; }
.wb-visual-name { min-width: 0; }
.wb-visual-name b,
.wb-visual-name small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wb-visual-name b { font-size: 12px; color: var(--ink); }
.wb-visual-name small { margin-top: 3px; color: var(--text-3); font-size: 10px; }
.wb-visual-row > strong { font-size: 14px; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink); }
.wb-progress { height: 6px; border-radius: 4px; background: var(--surface-2); overflow: hidden; }
.wb-progress i { display: block; height: 100%; border-radius: 4px; background: var(--primary); transition: width 0.3s; }
.wb-next-panel { display: flex; flex-direction: column; }
.wb-next-content { display: flex; align-items: flex-start; gap: 12px; flex: 1; padding: 10px 0 16px; }
.wb-next-mark {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 9px;
  background: var(--pastel-blue);
  color: var(--blue-ink);
  flex-shrink: 0;
}
.wb-next-content b,
.wb-next-content small { display: block; }
.wb-next-content b { font-size: 13px; line-height: 1.5; color: var(--ink); }
.wb-next-content small { margin-top: 5px; color: var(--text-3); font-size: 11px; line-height: 1.6; }
.wb-next-panel > .ant-btn { align-self: flex-start; }

.wb-section { margin-bottom: 14px; }
.wb-section-head,
.wb-panel-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 10px; }
.wb-section-head h2,
.wb-panel-head h2 { margin: 4px 0 0; font-size: 16px; letter-spacing: -0.02em; color: var(--ink); }

.wb-action-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface-2);
}
.wb-action-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 108px;
  padding: 14px 10px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  color: var(--ink);
  text-align: center;
  cursor: pointer;
  transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s, background 0.15s;
}
.wb-action-card:hover {
  border-color: var(--primary);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  transform: translateY(-1px);
}
.wb-action-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  flex-shrink: 0;
}
.wb-action-icon.blue { background: var(--pastel-blue); color: var(--blue-ink); }
.wb-action-icon.amber { background: var(--pastel-yellow); color: var(--yellow-ink); }
.wb-action-icon.green { background: var(--pastel-green); color: var(--green-ink); }
.wb-action-icon.violet { background: #f1ecff; color: #7450b5; }
.wb-action-copy { min-width: 0; }
.wb-action-copy b,
.wb-action-copy small { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wb-action-copy b { font-size: 13px; color: var(--ink); }
.wb-action-copy small { display: none; }
.wb-action-card .wb-arrow {
  position: absolute;
  top: 8px;
  right: 8px;
  color: var(--text-3);
  opacity: 0;
  transition: opacity 0.15s;
}
.wb-action-card:hover .wb-arrow { opacity: 1; }

.wb-columns { display: grid; grid-template-columns: 1.25fr 1fr; gap: 12px; margin-bottom: 12px; }
.wb-panel { padding: 16px 18px; }
.wb-panel-head .ant-btn { padding: 0; color: var(--blue-ink); font-size: 12px; }
.wb-exam-list,
.wb-todo-list { display: flex; flex-direction: column; }
.wb-exam-row {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 48px 62px 15px;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 3px;
  border: 0;
  border-top: 1px solid var(--border-2);
  background: transparent;
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  font: inherit;
}
.wb-exam-row:hover { background: var(--surface-2); }
.wb-exam-date,
.wb-exam-type { color: var(--text-3); font-size: 11px; }
.wb-exam-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
.wb-todo-list button {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 2px;
  border: 0;
  border-top: 1px solid var(--border-2);
  background: transparent;
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  font: inherit;
}
.wb-todo-list button:first-child { border-top: 0; }
.wb-todo-list button > span:nth-child(2) { flex: 1; }
.wb-todo-list b,
.wb-todo-list small { display: block; }
.wb-todo-list b { font-size: 13px; }
.wb-todo-list small { margin-top: 4px; color: var(--text-3); font-size: 11px; }
.wb-todo-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.wb-todo-dot.blue { background: #2d79bd; }
.wb-todo-dot.amber { background: #d69927; }
.wb-todo-dot.green { background: var(--green-ink); }
.wb-scan-panel { margin-bottom: 12px; }
.wb-inline-empty {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 64px;
  border-top: 1px solid var(--border-2);
  color: var(--text-3);
  font-size: 12px;
}
.wb-inline-empty span { flex: 1; }
.wb-batch-list { border-top: 1px solid var(--border-2); }
.wb-batch-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 70px 90px 100px;
  align-items: center;
  gap: 12px;
  min-height: 40px;
  border-bottom: 1px solid var(--border-2);
  font-size: 12px;
  color: var(--ink);
}
.wb-batch-row:last-child { border-bottom: 0; }
.wb-batch-row > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wb-batch-row > span:nth-child(2),
.wb-batch-row > span:last-child { color: var(--text-3); }

/* ---- 科技主题工作台 ---- */
body[data-theme='tech'] .wb-header {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.14) 0%, var(--surface) 55%);
  border-color: var(--border);
}
body[data-theme='tech'] .wb-header h1,
body[data-theme='tech'] .wb-header-meta b,
body[data-theme='tech'] .wb-metric strong,
body[data-theme='tech'] .wb-focus-copy h2,
body[data-theme='tech'] .wb-overview-head h2,
body[data-theme='tech'] .wb-section-head h2,
body[data-theme='tech'] .wb-action-copy b,
body[data-theme='tech'] .wb-resource-strip b {
  color: #ffffff;
}
body[data-theme='tech'] .wb-kicker { color: #c4b5fd; }
body[data-theme='tech'] .wb-header p,
body[data-theme='tech'] .wb-focus-copy p,
body[data-theme='tech'] .wb-metric small {
  color: #e4e4e7;
}
body[data-theme='tech'] .wb-focus-card {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), var(--surface));
  border-color: rgba(167, 139, 250, 0.22);
}
body[data-theme='tech'] .wb-focus-mark {
  background: rgba(124, 58, 237, 0.2);
  color: #ddd6fe;
}
body[data-theme='tech'] .wb-focus-action {
  background: linear-gradient(135deg, #7c3aed, #a78bfa);
  border-color: transparent;
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
}
body[data-theme='tech'] .wb-focus-action:hover {
  box-shadow: 0 6px 18px rgba(124, 58, 237, 0.45);
}
body[data-theme='tech'] .wb-overview-track i {
  background: linear-gradient(90deg, #7c3aed, #a78bfa);
}
body[data-theme='tech'] .wb-overview-head > strong {
  color: #c4b5fd;
}
body[data-theme='tech'] .wb-action-card:hover {
  border-color: rgba(167, 139, 250, 0.45);
  box-shadow: 0 6px 18px rgba(124, 58, 237, 0.18);
}
body[data-theme='tech'] .wb-action-icon.blue {
  background: rgba(59, 130, 246, 0.18);
  color: #93c5fd;
}
body[data-theme='tech'] .wb-action-icon.amber {
  background: rgba(245, 158, 11, 0.18);
  color: #fcd34d;
}
body[data-theme='tech'] .wb-action-icon.green {
  background: rgba(16, 185, 129, 0.18);
  color: #6ee7b7;
}
body[data-theme='tech'] .wb-action-icon.violet {
  background: rgba(124, 58, 237, 0.2);
  color: #ddd6fe;
}
body[data-theme='tech'] .wb-metric-label i {
  background: rgba(124, 58, 237, 0.15);
  color: #c4b5fd;
}
body[data-theme='tech'] .wb-resource-strip i.blue,
body[data-theme='tech'] .wb-resource-strip i:not(.violet):not(.green) {
  background: #60a5fa;
}
body[data-theme='tech'] .wb-resource-strip i.violet {
  background: #a78bfa;
}

@media (max-width: 1050px) {
  .wb-action-grid { grid-template-columns: repeat(2, 1fr); }
  .wb-columns,
  .wb-visual-grid { grid-template-columns: 1fr; }
}
@media (max-width: 680px) {
  .wb-header { align-items: flex-start; flex-direction: column; }
  .wb-header-meta { align-items: flex-start; }
  .wb-metrics { grid-template-columns: repeat(2, 1fr); }
  .wb-metric:nth-child(2) { border-right: 0; }
  .wb-metric:nth-child(-n + 2) { border-bottom: 1px solid var(--border); }
  .wb-focus-card { align-items: flex-start; flex-wrap: wrap; padding: 14px; }
  .wb-focus-action { margin-left: 58px; }
  .wb-flow-track { overflow: auto; padding-bottom: 4px; }
  .wb-flow-step { min-width: 100px; }
  .wb-action-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 10px; }
  .wb-action-card { min-height: 96px; padding: 12px 8px; }
  .wb-action-icon { width: 36px; height: 36px; }
  .wb-exam-row { grid-template-columns: 48px minmax(0, 1fr) 15px; }
  .wb-exam-type,
  .wb-exam-row .ant-tag { display: none; }
  .wb-batch-row { grid-template-columns: minmax(0, 1fr) 60px 70px; }
  .wb-batch-row > span:last-child { display: none; }
  .wb-visual-row { grid-template-columns: 30px minmax(90px, 1fr) 28px; }
  .wb-progress { display: none; }
}


/* ============================================
   教师工作台 · BoardUI 风格 bento 一屏版
   ============================================ */
# ---- Bento grid ----
.bc-wrap {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px 12px;
  overflow: hidden;
  color: var(--ink);
  box-sizing: border-box;
}

/* Top bar: single line, tight */
.bc-topbar {
  display: grid;
  grid-template-columns: auto auto 1fr auto;
  align-items: center;
  gap: 10px;
  min-height: 40px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  flex-shrink: 0;
}
.bc-greet { display: flex; flex-direction: column; gap: 0; }
.bc-time { color: var(--text-3); font-size: 10.5px; letter-spacing: 0.04em; line-height: 1.1; }
.bc-greet h1 { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); white-space: nowrap; line-height: 1.2; }

.bc-tabs {
  display: inline-flex;
  gap: 2px;
  padding: 2px;
  border-radius: 999px;
  background: var(--surface-2);
  border: 1px solid var(--border);
}
.bc-tabs button {
  min-height: 22px;
  padding: 0 10px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--text-2);
  font: inherit;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.12s, color 0.12s;
}
.bc-tabs button.on { background: var(--primary); color: #fff; }

.bc-classes {
  display: flex;
  gap: 5px;
  overflow-x: auto;
  min-width: 0;
  scrollbar-width: none;
}
.bc-classes::-webkit-scrollbar { display: none; }
.bc-class {
  flex-shrink: 0;
  min-height: 24px;
  padding: 0 10px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  font-size: 11px;
  cursor: pointer;
  transition: border-color 0.12s, background 0.12s, color 0.12s;
}
.bc-class:hover { border-color: var(--primary); }
.bc-class.on { border-color: var(--primary); background: rgba(45, 121, 189, 0.1); color: var(--primary); font-weight: 600; }

.bc-search {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 150px;
  min-height: 26px;
  padding: 0 8px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface-2);
  color: var(--text-3);
}
.bc-search .ant-input { color: var(--ink); font-size: 12px; }

.bc-meta { display: flex; flex-direction: column; gap: 0; text-align: right; font-size: 10.5px; color: var(--text-3); line-height: 1.25; white-space: nowrap; }
.bc-meta b { color: var(--primary); font-weight: 700; }
.bc-meta em { font-style: normal; }

/* ---- Bento grid ---- */
.bc-grid {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 200px 1fr 220px;
  gap: 8px;
}
.bc-col {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-height: 0;
}
.bc-left { }
.bc-center { }
.bc-right { }

/* ---- Card (shared) ---- */
.bc-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.bc-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  height: 30px;
  padding: 0 10px;
  border-bottom: 1px solid var(--border-2);
  flex-shrink: 0;
}
.bc-card-head > span {
  color: var(--text-3);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.bc-card-head b { color: var(--primary); font-size: 13px; line-height: 1; font-weight: 600; }
.bc-card-head small { color: var(--text-3); font-size: 10.5px; font-weight: 500; letter-spacing: 0; text-transform: none; }

/* Left col: diamond fills flex, memo pinned bottom */
.bc-diamond { flex: 1; min-height: 0; }
.bc-memo { flex-shrink: 0; }

/* ---- Diamond grid ---- */
.bc-diamond-grid {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  padding: 6px;
  gap: 6px;
  overflow: auto;
  align-content: start;
}
.bc-d-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-height: 60px;
  padding: 8px 4px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface-2);
  color: var(--ink);
  font: inherit;
  cursor: pointer;
  transition: border-color 0.12s, transform 0.12s, background 0.12s;
}
.bc-d-item:hover { border-color: var(--primary); transform: translateY(-1px); background: var(--surface); }
.bc-d-item b { font-size: 11.5px; font-weight: 600; white-space: nowrap; }
.bc-d-ic {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 7px;
}
.bc-d-ic.blue { background: var(--pastel-blue); color: var(--blue-ink); }
.bc-d-ic.amber { background: var(--pastel-yellow); color: var(--yellow-ink); }
.bc-d-ic.green { background: var(--pastel-green); color: var(--green-ink); }
.bc-d-ic.violet { background: #f1ecff; color: #7450b5; }

/* ---- Memo ---- */
.bc-memo .ant-input {
  background: var(--surface-2);
  color: var(--ink);
  border-color: var(--border);
  font-size: 12px;
}
.bc-memo .ant-input-affix-wrapper { padding: 4px 8px; }
.bc-memo .ant-input-affix-wrapper textarea { font-size: 12px; }

/* ---- Schedule (center, fills column) ---- */
.bc-schedule { flex: 1; min-height: 0; padding: 0; }
.bc-schedule .bc-card-head { height: 34px; padding: 0 14px; }
.bc-schedule > :not(.bc-card-head) {
  flex: 1;
  min-height: 0;
  padding: 10px 12px 12px;
  overflow: auto;
  display: flex;
  flex-direction: column;
}
.bc-empty {
  height: 100%;
  display: grid;
  place-items: center;
  color: var(--text-3);
  font-size: 13px;
}

/* ---- Right column cards ---- */
.bc-right { flex: 1; }
.bc-right .bc-card { }

/* Today list */
.bc-today { flex-shrink: 0; }
.bc-today-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 4px 10px 6px;
}
.bc-today-empty { color: var(--text-3); font-size: 12px; padding: 8px 0; text-align: center; }
.bc-today-row {
  display: grid;
  grid-template-columns: 42px 1fr auto;
  gap: 6px;
  align-items: center;
  min-height: 22px;
  padding: 2px 4px;
  border-radius: 4px;
  font-size: 12px;
  transition: background 0.1s;
}
.bc-today-row:hover { background: var(--surface-2); }
.bc-today-period {
  color: var(--text-3);
  font-size: 10.5px;
  font-variant-numeric: tabular-nums;
}
.bc-today-subj { color: var(--ink); font-weight: 600; }
.bc-today-cls { color: var(--text-3); font-size: 10.5px; white-space: nowrap; }

/* Progress */
.bc-progress { flex-shrink: 0; }
.bc-progress .ant-progress { margin: 4px 12px 0 !important; }
.bc-prog-range {
  display: block;
  margin: 4px 12px 8px;
  color: var(--text-3);
  font-size: 10.5px;
  text-align: right;
}

/* Calendar (fills remaining right col height) */
.bc-cal { flex: 1; min-height: 140px; }
.bc-cal .ant-picker-calendar { background: transparent; height: 100%; }
.bc-cal .ant-picker-calendar-mini { padding: 0 6px; }
.bc-cal .ant-picker-calendar-mini .ant-picker-calendar-header { padding: 6px 4px; }
.bc-cal .ant-picker-calendar-mini .ant-picker-cell { padding: 2px 0; }
.bc-cal .ant-picker-calendar-mini .ant-picker-cell .ant-picker-calendar-day > div { height: 18px; line-height: 18px; }
.bc-cal .ant-picker-calendar-mini .ant-picker-calendar-body { padding: 0 4px 6px; }
.bc-cal-dot {
  display: block;
  width: 5px;
  height: 5px;
  margin: 1px auto 0;
  border-radius: 50%;
  background: var(--primary);
}

/* Todo (pinned bottom of right col) */
.bc-todo { flex-shrink: 0; }
.bc-todo-list {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding: 2px 10px 4px;
}
.bc-todo-list label {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 22px;
  color: var(--ink);
  font-size: 12px;
}
.bc-todo-list label.done > span:last-of-type { color: var(--text-3); text-decoration: line-through; }
.bc-todo-list label > span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bc-todo-list label > button {
  border: 0;
  background: transparent;
  color: var(--text-3);
  cursor: pointer;
  font-size: 14px;
  line-height: 1;
  opacity: 0.4;
  transition: opacity 0.1s;
}
.bc-todo-list label:hover > button { opacity: 1; }
.bc-todo-add {
  display: flex;
  gap: 5px;
  padding: 2px 10px 6px;
}
.bc-todo-add .ant-input { font-size: 12px; height: 28px; }
.bc-todo-add > button {
  flex-shrink: 0;
  min-height: 28px;
  padding: 0 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface-2);
  color: var(--ink);
  font: inherit;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
}
.bc-todo-add > button:hover { border-color: var(--primary); color: var(--primary); }

/* ---- Tech theme dark overrides ---- */
body[data-theme='tech'] .bc-wrap { color: #fff; }
body[data-theme='tech'] .bc-topbar,
body[data-theme='tech'] .bc-card,
body[data-theme='tech'] .bc-class,
body[data-theme='tech'] .bc-d-item {
  background: var(--surface);
  border-color: var(--border);
}
body[data-theme='tech'] .bc-greet h1,
body[data-theme='tech'] .bc-card-head > span + b,
body[data-theme='tech'] .bc-today-subj,
body[data-theme='tech'] .bc-todo-list label {
  color: #fff;
}
body[data-theme='tech'] .bc-tabs button.on {
  background: linear-gradient(135deg, #7c3aed, #a78bfa);
}
body[data-theme='tech'] .bc-class.on {
  background: rgba(124, 58, 237, 0.18);
  border-color: rgba(167, 139, 250, 0.45);
  color: #c4b5fd;
}
body[data-theme='tech'] .bc-d-ic.blue { background: rgba(59, 130, 246, 0.18); color: #93c5fd; }
body[data-theme='tech'] .bc-d-ic.amber { background: rgba(245, 158, 11, 0.18); color: #fcd34d; }
body[data-theme='tech'] .bc-d-ic.green { background: rgba(16, 185, 129, 0.18); color: #6ee7b7; }
body[data-theme='tech'] .bc-d-ic.violet { background: rgba(124, 58, 237, 0.2); color: #ddd6fe; }

/* ---- Responsive ---- */
@media (max-width: 1200px) {
  .bc-grid { grid-template-columns: 170px 1fr 200px; }
}
@media (max-width: 1024px) {
  .bc-grid { grid-template-columns: 1fr; grid-template-rows: auto auto auto; }
  .bc-left, .bc-right { flex-direction: row; flex-wrap: wrap; }
  .bc-left > *, .bc-right > * { flex: 1; min-width: 220px; }
  .bc-cal { min-height: 200px; }
  .bc-wrap { overflow-y: auto; }
}


