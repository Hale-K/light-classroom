# ===== OS / 编辑器 =====
Thumbs.db
.DS_Store
.idea/
.vscode/

# ===== 环境与密钥（保留 example）=====
.env
.env.*
!.env.example

# ===== 日志与临时文件 =====
*.log
logs/

# ===== 依赖与构建产物（与子目录规则重叠，双保险）=====
node_modules/
dist/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.tsbuildinfo

# ===== 数据备份（数据库 dump / 排查数据，不入库）=====
backend/backups/

# ===== 本机导出目录与一次性脚本产物 =====
backend/scripts/_last_timetable.pkl
docs/chrome-check-profile/

# ===== 含学生/口令的库导出，禁止进公开仓库 =====
db/*.sql
!db/README-sql.md
!db/schema/
!db/schema/*.sql

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
