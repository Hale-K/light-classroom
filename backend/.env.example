# ========== 应用配置 ==========
APP_NAME=轻课堂
APP_ENV=dev                      # dev / staging / prod
APP_DEBUG=true
# 学校代码（私有化部署时固定单值；SaaS 由请求头 X-School-Code 携带）
DEFAULT_SCHOOL_CODE=demo

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://zhiheng:zhiheng@localhost:5432/zhiheng
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== Kafka 事件总线（默认直连本机专属实例 9093；镜像编排见 docker-compose.kafka.yml） ==========
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_TOPIC_GRADING=grading-events
KAFKA_TOPIC_PRACTICE=practice-events
KAFKA_TOPIC_PREDICTION=prediction-events

# ========== JWT 认证 ==========
JWT_SECRET_KEY=change-me-in-production-please-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24h

# ========== LLM（OpenAI 兼容协议，可配 DeepSeek/GLM/通义） ==========
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
# 成本红线：单生单卷 LLM 成本上限（元）
LLM_COST_LIMIT_PER_SHEET=0.5

# ========== 对象存储（腾讯云 COS） ==========
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=light-classroom-1250000000

# ========== Celery ==========
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
