# ========== 应用配置 ==========
APP_NAME=轻课堂
APP_ENV=dev                      # dev / staging / prod
APP_DEBUG=true
# 学校代码（私有化部署时固定单值；SaaS 由请求头 X-School-Code 携带）
DEFAULT_SCHOOL_CODE=demo

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://zhiheng:zhiheng@localhost:5432/zhiheng
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== Kafka 事件总线（默认直连本机专属实例 9093；镜像编排见 docker-compose.kafka.yml） ==========
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_TOPIC_GRADING=grading-events
KAFKA_TOPIC_PRACTICE=practice-events
KAFKA_TOPIC_PREDICTION=prediction-events

# ========== JWT 认证 ==========
JWT_SECRET_KEY=change-me-in-production-please-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24h

# ========== LLM（OpenAI 兼容协议，可配 DeepSeek/GLM/通义） ==========
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
# 成本红线：单生单卷 LLM 成本上限（元）
LLM_COST_LIMIT_PER_SHEET=0.5
# 教务助手服务商熔断：连续健康故障次数与隔离秒数
ASSISTANT_PROVIDER_FAILURE_THRESHOLD=2
ASSISTANT_PROVIDER_COOLDOWN_SECONDS=60
# 本地中文向量模型；生产环境可换成挂载目录
ASSISTANT_EMBEDDING_MODEL_PATH=E:/llm-models/embedding/bge-base-zh-v1.5

# ========== 对象存储（腾讯云 COS，生产可配） ==========
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=light-classroom-1250000000

# ========== MinIO（本地文件中心，docker compose 服务 minio）==========
# 控制台 http://localhost:9011  账号 lightclassroom / lightclassroom
# API    http://localhost:9010  bucket: light-classroom
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=lightclassroom
MINIO_SECRET_KEY=lightclassroom
MINIO_BUCKET=light-classroom
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9010

# ========== Celery（broker = 本机 RabbitMQ，编排见 docker-compose.rabbitmq.yml）==========
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 生产前端来源白名单，多个地址用逗号分隔
CORS_ORIGINS=http://82.156.162.251
# 用于加密数据库中的 AI 服务商 API Key；生产环境请设置随机高强度值
API_KEY_ENCRYPTION_KEY=
