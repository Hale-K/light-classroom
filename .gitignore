# ===== OS / 编辑器 =====
Thumbs.db
.DS_Store
.idea/
.vscode/

# ===== 环境与密钥（保留 example）=====
.env
.env.*
!.env.example

# ===== 日志与临时文件 =====
*.log
logs/

# ===== 依赖与构建产物（与子目录规则重叠，双保险）=====
node_modules/
dist/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.tsbuildinfo

# ===== 数据备份（数据库 dump / 排查数据，不入库）=====
backend/backups/

# ===== 本机导出目录与一次性脚本产物 =====
backend/scripts/_last_timetable.pkl
docs/chrome-check-profile/

# ===== 含学生/口令的库导出，禁止进公开仓库 =====
db/*.sql
!db/README-sql.md
!db/schema/
!db/schema/*.sql
